{
  "name": "lotto-history-checker",
  "version": "1.0.0",
  "private": true,
  "description": "로또 6/45 번호를 역대 전 회차와 대조해 1~3등 당첨 이력을 찾아주는 웹 UI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fetch": "python3 scripts/fetch_lotto_history.py -o public/lotto_history.json",
    "fetch:win": "python scripts/fetch_lotto_history.py -o public/lotto_history.json",
    "serve:dist": "python3 -m http.server 4173 --directory dist",
    "icons": "python scripts/make_icons.py",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0"
  }
}
